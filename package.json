{
  "name": "ubunifu-sec-sms",
  "version": "1.0.0",
  "description": "UBUNIFU SEC Student Management System - React + Node.js + MySQL",
  "main": "server/server.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon --watch server --ext js,json server/server.js",
    "client": "cd client && HOST=127.0.0.1 npm start",
    "build": "cd client && npm run build",
    "start": "node server/server.js",
    "install-client": "cd client && npm install",
    "install-server": "npm install",
    "install-all": "npm run install-server && npm run install-client",
    "migrate": "node server/scripts/run-migrations.js",
    "reset-admins": "node server/scripts/reset-admin-passwords.js",
    "list-admins": "node server/scripts/list-admins.js",
    "create-admins": "node server/scripts/create-admins.js",
    "test": "cd client && npm test"
  },
  "keywords": [
    "student-management",
    "school-management",
    "education",
    "sms",
    "ubunifu-sec",
    "react",
    "nodejs",
    "mysql"
  ],
  "author": "UBUNIFU SEC",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.11.0",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.5.0",
    "cors": "^2.8.5",
    "docx": "^9.5.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "html2canvas": "^1.4.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^3.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.6.5",
    "node-cron": "^4.2.1",
    "pdfkit": "^0.17.2",
    "react-chartjs-2": "^5.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "uuid": "^9.0.1",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "node-fetch": "^3.3.2",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
