# UBUNIFU SEC School Management System - Environment Configuration
# Copy this file to .env and update the values for your deployment

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sms_password
DB_NAME=sms_database
DB_ROOT_PASSWORD=rootpassword
DB_SSL=false
DB_SSL_CA=
DB_SSL_REJECT_UNAUTHORIZED=true

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE_TIME=24h

# Server Configuration
PORT=5000
NODE_ENV=production

# NextSMS (server-side only)
NEXTSMS_ENABLED=true
NEXTSMS_BASE_URL=https://messaging-service.co.tz
NEXTSMS_API_TOKEN=
NEXTSMS_USERNAME=mosatgentlemedy.d63
NEXTSMS_PASSWORD=Allahuma@11
NEXTSMS_SENDER_ID=MosatInc

# Frontend Configuration
REACT_APP_API_URL=/api

# Payments (PayPal.Me simple integration)
# Example: https://www.paypal.me/YourSchoolAccount
REACT_APP_PAYPAL_ME_URL=

# Payments (Pesapal)
# Never commit real keys to the repository.
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_BASE_URL=https://pay.pesapal.com/v3
PESAPAL_IPN_ID=
# Recommended: backend callback endpoints, which then redirect to frontend.
PESAPAL_CALLBACK_URL=http://localhost:5000/api/parent/payments/pesapal/callback
PESAPAL_CANCEL_URL=http://localhost:5000/api/parent/payments/pesapal/cancel

# Security Settings
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Email Configuration (if using email features)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=noreply@ubunifusec.com

# Email Notifications (Brevo Transactional Email)
# IMPORTANT: Never commit real API keys. Rotate any key that was shared in chat.
EMAIL_NOTIFICATIONS_ENABLED=true
BREVO_API_KEY=
BREVO_SENDER_EMAIL=montanafrenv@gmail.com
BREVO_SENDER_NAME=UBUNIFU SEC SMS

# Daily attendance email digest (cron in server timezone)
# Default in code is "30 17 * * *" (17:30)
PARENT_DAILY_ATTENDANCE_EMAIL_CRON=30 17 * * *

# File Upload Settings
MAX_FILE_SIZE=50MB
UPLOAD_PATH=/app/uploads

# Cloudflare R2 Materials Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional custom domain or public base URL for object delivery, without trailing slash.
R2_PUBLIC_BASE_URL=

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=/app/logs

# Session Configuration
SESSION_SECRET=your_session_secret_change_this_in_production

# OTP Settings
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# School Information
SCHOOL_NAME=UBUNIFU SEC
SCHOOL_CODE=UBSEC
SCHOOL_EMAIL=info@ubunifusec.com
SCHOOL_PHONE=+255615082570
SCHOOL_ADDRESS=Dodoma, Tanzania

# Timezone
TZ=Africa/Dar_es_Salaam
